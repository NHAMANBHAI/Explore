# =====================================================================
# HyperLocal Multi-Vendor & FlexiCommerce — Next.js Environment Setup
# =====================================================================

# ---------------------------------------------------------------------
# 1. Application & Server Configuration
# ---------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_NAME="FlexiCommerce & HyperLocal Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"
NEXT_PUBLIC_BACKEND_API_URL="https://hyperlocal-backend.eshopweb.store"

# Security & Session Secrets
JWT_SECRET="hyperlocal-super-secret-jwt-token-key-2026"
SESSION_EXPIRY_MINUTES="120"

# ---------------------------------------------------------------------
# 2. MySQL & Sequelize Database Configuration
# ---------------------------------------------------------------------
# Local MySQL credentials (compatible with XAMPP, WAMP, Laragon, Docker, MySQL Workbench)
DB_DIALECT="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="hyperlocal_db"
DB_USER="root"
DB_PASSWORD=""

# Complete MySQL connection string
DATABASE_URL="mysql://root:@127.0.0.1:3306/hyperlocal_db"

# Fallback mode: When MySQL is offline, the portal operates with 
# rich in-memory mock datasets so all UI tabs & pages work out-of-the-box!
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK="true"

# ---------------------------------------------------------------------
# 3. Default Administrative Credentials
# ---------------------------------------------------------------------
NEXT_PUBLIC_DEMO_ADMIN_EMAIL="hyperlocaladmin@gmail.com"
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD="12345678"

# ---------------------------------------------------------------------
# 4. Firebase Authentication & Google OAuth
# Get credentials from: https://console.firebase.google.com/
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ---------------------------------------------------------------------
# 5. Geofencing & Maps (Google Maps / OpenStreetMap)
# ---------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_DEFAULT_MAP_LAT="23.0225"
NEXT_PUBLIC_DEFAULT_MAP_LNG="72.5714"
NEXT_PUBLIC_DEFAULT_MAP_ZOOM="13"

# ---------------------------------------------------------------------
# 6. Real-Time WebSockets (Pusher / Laravel Reverb)
# ---------------------------------------------------------------------
NEXT_PUBLIC_PUSHER_APP_KEY=""
NEXT_PUBLIC_PUSHER_APP_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_HOST=""
NEXT_PUBLIC_PUSHER_PORT="443"
NEXT_PUBLIC_PUSHER_SCHEME="https"

# ---------------------------------------------------------------------
# 7. Indian Payment Gateways & Logistics
# ---------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# ---------------------------------------------------------------------
# 8. Dual Compatibility Aliases (for components referencing VITE_*)
# ---------------------------------------------------------------------
VITE_APP_NAME="FlexiCommerce & HyperLocal Platform"
VITE_API_BASE_URL="https://hyperlocal-backend.eshopweb.store"
VITE_DEMO_ADMIN_EMAIL="hyperlocaladmin@gmail.com"
VITE_DEMO_ADMIN_PASSWORD="12345678"
VITE_ENABLE_MOCK_FALLBACK="true"
