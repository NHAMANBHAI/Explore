# =====================================================================
# HyperLocal Admin Console — Environment Configuration
# =====================================================================

# Application Details
VITE_APP_NAME="HyperLocal Admin Console"
VITE_APP_ENV="development"
VITE_APP_VERSION="2.6.0"

# HyperLocal Backend API URL
VITE_API_BASE_URL="https://hyperlocal-backend.eshopweb.store"

# =====================================================================
# Firebase Authentication & Google OAuth Configuration
# Get these credentials from your Firebase Console:
# https://console.firebase.google.com/ > Project Settings > General
# =====================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Fallback mode: When Firebase keys are blank, the portal operates
# with built-in development simulated Google OAuth and root admin credentials
VITE_ENABLE_MOCK_FALLBACK="true"

# Default Demo Administrative Credentials
VITE_DEMO_ADMIN_EMAIL="hyperlocaladmin@gmail.com"
VITE_DEMO_ADMIN_PASSWORD="password"

# =====================================================================
# Maps & Geofencing (Google Maps API / OpenStreetMap)
# =====================================================================
VITE_GOOGLE_MAPS_API_KEY=""
VITE_DEFAULT_MAP_LAT="28.6280"
VITE_DEFAULT_MAP_LNG="77.3649"
VITE_DEFAULT_MAP_ZOOM="13"

# =====================================================================
# Real-Time WebSockets (Laravel Reverb / Pusher)
# =====================================================================
VITE_PUSHER_APP_KEY=""
VITE_PUSHER_APP_CLUSTER="mt1"
VITE_PUSHER_HOST=""
VITE_PUSHER_PORT="443"
VITE_PUSHER_SCHEME="https"
