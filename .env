# =====================================================================
# HyperLocal Multi-Vendor & FlexiCommerce — Next.js Environment Setup
# =====================================================================

# ---------------------------------------------------------------------
# 1. Application & Server Configuration
# ---------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_NAME="FlexiCommerce & HyperLocal Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"

# ---------------------------------------------------------------------
# 2. MySQL & Sequelize Database Configuration
# ---------------------------------------------------------------------
# Default local MySQL credentials (compatible with XAMPP, Wamp, Docker, MySQL Community)
DB_DIALECT="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="hyperlocal_db"
DB_USER="root"
DB_PASSWORD=""

# Complete MySQL connection string
DATABASE_URL="mysql://root:@127.0.0.1:3306/hyperlocal_db"

# Fallback mode: When MySQL is offline or not installed, the app uses 
# high-fidelity in-memory/mock state so the full UI and demo work instantly!
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK="true"

# ---------------------------------------------------------------------
# 3. Default Administrative Credentials
# ---------------------------------------------------------------------
NEXT_PUBLIC_DEMO_ADMIN_EMAIL="hyperlocaladmin@gmail.com"
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD="password"

# ---------------------------------------------------------------------
# 4. Firebase Authentication & Google OAuth
# Get credentials from: https://console.firebase.google.com/
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ---------------------------------------------------------------------
# 5. Geofencing & Maps (Google Maps / OpenStreetMap)
# ---------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_DEFAULT_MAP_LAT="23.0225"
NEXT_PUBLIC_DEFAULT_MAP_LNG="72.5714"
NEXT_PUBLIC_DEFAULT_MAP_ZOOM="13"

# ---------------------------------------------------------------------
# 6. Real-Time WebSockets (Pusher / Laravel Reverb)
# ---------------------------------------------------------------------
NEXT_PUBLIC_PUSHER_APP_KEY=""
NEXT_PUBLIC_PUSHER_APP_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_HOST=""
NEXT_PUBLIC_PUSHER_PORT="443"
NEXT_PUBLIC_PUSHER_SCHEME="https"

# ---------------------------------------------------------------------
# 7. Indian Payment Gateways & Logistics
# ---------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
