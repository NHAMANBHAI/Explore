# =====================================================================
# HyperLocal Multi-Vendor & FlexiCommerce — Next.js Environment Setup
# =====================================================================

NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_NAME="FlexiCommerce & HyperLocal Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"
NEXT_PUBLIC_BACKEND_API_URL="https://hyperlocal-backend.eshopweb.store"

JWT_SECRET="hyperlocal-super-secret-jwt-token-key-2026"
SESSION_EXPIRY_MINUTES="120"

# MySQL Database
DB_DIALECT="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="hyperlocal_db"
DB_USER="root"
DB_PASSWORD=""
DATABASE_URL="mysql://root:@127.0.0.1:3306/hyperlocal_db"
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK="true"

# Demo Credentials
NEXT_PUBLIC_DEMO_ADMIN_EMAIL="hyperlocaladmin@gmail.com"
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD="12345678"

# Firebase & Google OAuth
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_DEFAULT_MAP_LAT="23.0225"
NEXT_PUBLIC_DEFAULT_MAP_LNG="72.5714"
NEXT_PUBLIC_DEFAULT_MAP_ZOOM="13"

# Pusher WebSockets
NEXT_PUBLIC_PUSHER_APP_KEY=""
NEXT_PUBLIC_PUSHER_APP_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_HOST=""
NEXT_PUBLIC_PUSHER_PORT="443"
NEXT_PUBLIC_PUSHER_SCHEME="https"
